<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Login Link</title>
</head>
<body>
<p>Your one-time login token:</p>
<p><strong>{{ token }}</strong></p>
<p>Confirm token via API endpoint:</p>
<p><code>{{ confirmEndpoint }}</code></p>
<p>JSON payload:</p>
<pre>{{ requestPayload }}</pre>
</body>
</html>
