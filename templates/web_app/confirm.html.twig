{% extends 'base.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ 'auth.confirm.title'|trans }}{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="/web-app/app.css">
{% endblock %}

{% block body %}
<main class="auth-layout">
  <section class="auth-panel narrow">
    <div class="brand-block">
      <span class="brand-mark">WC</span>
      <h1>{{ 'auth.confirm.heading'|trans }}</h1>
      <p class="account-line">{{ pendingEmail }}</p>
    </div>

    {% include 'web_app/_flash.html.twig' %}

    <section class="surface">
      {{ form_start(confirmForm, { action: confirmAction|default(path('app_web_confirm_submit')), attr: { class: 'stack-form' } }) }}
        {{ form_row(confirmForm.token) }}
        <button class="button button-primary" type="submit">{{ 'auth.confirm.submit'|trans }}</button>
      {{ form_end(confirmForm) }}
    </section>
  </section>
</main>
{% endblock %}
