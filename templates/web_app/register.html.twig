{% extends 'base.html.twig' %}

{% block title %}Create account | Wallet Console{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="/web-app/app.css">
{% endblock %}

{% block javascripts %}
    <script>
        function togglePassword() {
            const button = document.querySelector('.password-toggle');
            const input = button.previousElementSibling;
            const icon = document.getElementById('eye-icon');

            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = `
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
            <line x1="1" y1="1" x2="23" y2="23"/>
        `;
            } else {
                input.type = 'password';
                icon.innerHTML = `
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
        `;
            }
        }

        window.addEventListener('DOMContentLoaded', async () => {
            const field = document.querySelector('[data-device-fingerprint="registration"]');
            if (!field) {
                return;
            }

            const storageKey = 'wallet_console_device_seed';
            let seed = window.localStorage.getItem(storageKey);
            if (!seed) {
                seed = window.crypto && window.crypto.randomUUID
                    ? window.crypto.randomUUID()
                    : `${Date.now()}-${Math.random().toString(16).slice(2)}`;
                window.localStorage.setItem(storageKey, seed);
            }

            const parts = [
                seed,
                window.navigator.userAgent || '',
                window.navigator.language || '',
                `${window.screen.width}x${window.screen.height}x${window.screen.colorDepth}`,
                Intl.DateTimeFormat().resolvedOptions().timeZone || '',
            ];

            if (!window.crypto || !window.crypto.subtle) {
                field.value = `web-${seed.replace(/[^a-zA-Z0-9-]/g, '').slice(0, 120)}`;

                return;
            }

            const digest = await window.crypto.subtle.digest('SHA-256', new TextEncoder().encode(parts.join('|')));
            const hash = Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('');
            field.value = `web-${hash}`;
        });
    </script>
{% endblock %}

{% block body %}
<main class="auth-layout">
  <section class="auth-panel narrow">
    <div class="brand-block">
      <span class="brand-mark">WC</span>
      <h1>Create account</h1>
      <p>Wallet Console account access for the demo workspace.</p>
    </div>

    {% include 'web_app/_flash.html.twig' %}

    <section class="surface">
      <h2>Registration</h2>
      {{ form_start(registerForm, { action: path('app_web_register'), attr: { class: 'stack-form' } }) }}
        {{ form_row(registerForm.email) }}
        <div class="form-row">
            {{ form_label(registerForm.password) }}
            <div class="input-wrapper" style="position: relative;">
                {{ form_widget(registerForm.password, { attr: { id: 'password-field' } }) }}
                <button type="button" class="password-toggle" onclick="togglePassword()">
                    <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                </button>
            </div>
            {{ form_errors(registerForm.password) }}
        </div>
        {{ form_widget(registerForm.deviceFingerprint) }}
        {{ form_errors(registerForm.deviceFingerprint) }}
        <button class="button button-primary" type="submit">Create account</button>
      {{ form_end(registerForm) }}

      <div class="auth-switch">
        <span>Already registered?</span>
        <a class="button button-muted" href="{{ path('app_web_login') }}">Sign in</a>
      </div>
    </section>
  </section>
</main>
{% endblock %}
