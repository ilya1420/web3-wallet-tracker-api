{% extends 'base.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ 'wallet.new.title'|trans }}{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="/web-app/app.css">
{% endblock %}

{% block body %}
<main class="app-shell">
  {% include 'web_app/_sidebar.html.twig' with { active: 'wallet_new' } %}

  <section class="content">
    <header class="page-head">
      <div>
        <h1>{{ 'wallet.new.heading'|trans }}</h1>
        <p>{{ 'wallet.new.subtitle'|trans }}</p>
      </div>
    </header>

    {% include 'web_app/_flash.html.twig' %}

    <section class="form-layout">
      <article class="panel">
        {{ form_start(walletCreateForm, { action: path('app_wallet_create'), attr: { class: 'stack-form wallet-create-form' } }) }}
          {{ form_row(walletCreateForm.address) }}
          {{ form_row(walletCreateForm.rpcPreset) }}
          {{ form_row(walletCreateForm.rpcEndpoint) }}
          <div class="form-actions">
            <button class="button button-primary" type="submit">{{ 'wallet.new.connect'|trans }}</button>
            <a class="button button-muted" href="{{ path('app_dashboard') }}">{{ 'common.cancel'|trans }}</a>
          </div>
        {{ form_end(walletCreateForm) }}
      </article>

      <aside class="network-list">
        {% for preset in presets %}
          <div class="network-row">
            <strong>{{ preset.networkName }}</strong>
            <span>{{ 'wallet.chain'|trans({'%symbol%': preset.nativeSymbol, '%chainId%': preset.networkId}) }}</span>
          </div>
        {% endfor %}
      </aside>
    </section>
  </section>
</main>
{% endblock %}

{% block javascripts %}
    <script>
        (() => {
            const presetToRpc = {
            {% for preset in presets %}
            {{ preset.value|json_encode|raw }}: {{ preset.endpoint()|json_encode|raw }}{{ not loop.last ? ',' : '' }}
            {% endfor %}
        };
            const preset = document.getElementById({{ walletCreateForm.rpcPreset.vars.id|json_encode|raw }});
            const endpoint = document.getElementById({{ walletCreateForm.rpcEndpoint.vars.id|json_encode|raw }});

            if (!preset || !endpoint) {
                return;
            }

            const knownValues = Object.values(presetToRpc);

            const sync = () => {
                const next = presetToRpc[preset.value] || '';

                if (!next) {
                    return;
                }

                const current = endpoint.value.trim();

                if (current === '' || knownValues.includes(current)) {
                    endpoint.value = next;
                }
            };

            preset.addEventListener('change', sync);
            sync();
        })();
    </script>
{% endblock %}
