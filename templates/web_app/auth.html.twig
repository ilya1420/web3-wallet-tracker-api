{% extends 'base.html.twig' %}

{% block title %}Sign in | Wallet Console{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="/web-app/app.css">
{% endblock %}

{% block body %}
<main class="auth-layout">
  <section class="auth-panel narrow">
    <div class="brand-block">
      <span class="brand-mark">WC</span>
      <h1>Wallet Console</h1>
      <p>Account access and EVM wallet monitoring for the demo workspace.</p>
    </div>

    {% include 'web_app/_flash.html.twig' %}

    <section class="surface">
      <h2>Sign in</h2>
      {{ form_start(loginForm, { action: path('app_web_login_submit'), attr: { class: 'stack-form' } }) }}
        {{ form_row(loginForm.email) }}
        <div class="form-row">
            {{ form_label(loginForm.password) }}
            <div class="input-wrapper" style="position: relative;">
                {{ form_widget(loginForm.password, { attr: { id: 'password-field' } }) }}
                <button type="button" class="password-toggle" onclick="togglePassword()">
                    <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                </button>
            </div>
            {{ form_errors(loginForm.password) }}
        </div>
        <button class="button button-primary" type="submit">Sign in</button>
      {{ form_end(loginForm) }}

      <div class="auth-switch">
        <span>New workspace?</span>
        <a class="button button-muted" href="{{ path('app_web_register_form') }}">Create account</a>
      </div>
    </section>
  </section>
</main>
{% endblock %}

{% block javascripts %}
    <script>
        function togglePassword() {
            const button = document.querySelector('.password-toggle');
            const input = button.previousElementSibling;
            const icon = document.getElementById('eye-icon');

            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = `
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
            <line x1="1" y1="1" x2="23" y2="23"/>
        `;
            } else {
                input.type = 'password';
                icon.innerHTML = `
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
        `;
            }
        }
    </script>
{% endblock %}
