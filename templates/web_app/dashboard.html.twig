{% extends 'base.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ 'dashboard.title'|trans }}{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="/web-app/app.css">
{% endblock %}

{% block body %}
<main class="app-shell">
  {% include 'web_app/_sidebar.html.twig' with { active: 'overview' } %}

  <section class="content">
    <header class="page-head">
      <div>
        <h1>{{ 'dashboard.overview'|trans }}</h1>
        <p>{{ currentUser.email }}</p>
      </div>
      <a class="button button-primary" href="{{ path('app_wallet_new') }}">{{ 'wallet.add'|trans }}</a>
    </header>

    {% include 'web_app/_flash.html.twig' %}

    <section class="metric-grid">
      <article class="metric"><span>{{ 'dashboard.metric.total_wallets'|trans }}</span><strong>{{ summary.total }}</strong></article>
      <article class="metric"><span>{{ 'dashboard.metric.networks'|trans }}</span><strong>{{ summary.networks }}</strong></article>
      <article class="metric"><span>{{ 'dashboard.metric.synced'|trans }}</span><strong>{{ summary.synced }}</strong></article>
      <article class="metric"><span>{{ 'dashboard.metric.with_balance'|trans }}</span><strong>{{ summary.withBalance }}</strong></article>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>{{ 'dashboard.connected_wallets'|trans }}</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>{{ 'wallet.table.wallet'|trans }}</th>
              <th>{{ 'wallet.table.network'|trans }}</th>
              <th>{{ 'wallet.table.balance'|trans }}</th>
              <th>{{ 'wallet.table.last_sync'|trans }}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for wallet in wallets %}
              <tr>
                <td><span class="mono">{{ wallet.address }}</span></td>
                <td>{{ wallet.networkName }}</td>
                <td>
                  <span class="pill">{{ wallet.lastKnownBalanceDisplay ?: 'wallet.not_synced'|trans }}</span>
                  {% if walletUsdValues[wallet.id] is defined %}
                    <span class="balance-usd" title="{{ 'wallet.usd_estimate_updated'|trans }}: {{ walletUsdValues[wallet.id].updatedAt|date('Y-m-d H:i:s T') }}">≈ ${{ walletUsdValues[wallet.id].amount }}</span>
                  {% endif %}
                </td>
                <td>{{ wallet.lastSyncedAt ? wallet.lastSyncedAt|date('Y-m-d H:i') : '-' }}</td>
                <td><a class="button button-small" href="{{ path('app_wallet_show', { id: wallet.id }) }}">{{ 'common.view'|trans }}</a></td>
              </tr>
            {% else %}
              <tr><td colspan="5" class="empty-cell">{{ 'dashboard.no_wallets'|trans }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  </section>
</main>
{% endblock %}
