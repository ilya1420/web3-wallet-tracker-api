APP_ENV=dev
APP_SECRET=change_this_secret
APP_URL=http://localhost

DATABASE_URL=mysql://app:app_password@mysql:3306/app?serverVersion=8.4&charset=utf8mb4
REDIS_URL=redis://redis:6379
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages
MAILER_DSN=smtp://mailhog:1025
MAILER_FROM=no-reply@local.test

ACCESS_TOKEN_TTL=PT24H
LOGIN_TOKEN_TTL=PT15M
LOGIN_RATE_LIMIT=5
REGISTRATION_MAX_PER_IP_DAY=3
WEB3_DEFAULT_RPC_URL=http://host.docker.internal:8545
WEB3_REQUEST_TIMEOUT=3
DEFAULT_URI=http://localhost:8080
